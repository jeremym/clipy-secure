    "ClipySecure needs Accessibility permission to automatically paste items when you select them from the menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure benötigt die Bedienungshilfen-Berechtigung, um Einträge beim Auswählen aus dem Menü automatisch einzufügen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure necessita dell'autorizzazione accessibilità per incollare automaticamente gli elementi selezionati dal menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecureはメニューから選択したアイテムを自動的に貼り付けるためにアクセシビリティ権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure 需要辅助功能权限来在您从菜单选择项目时自动粘贴。"
          }
        }
      }
    },
    "ClipySecure needs Accessibility permission to automatically paste items. Please enable it in System Settings > Privacy & Security > Accessibility." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure benötigt die Bedienungshilfen-Berechtigung, um Einträge automatisch einzufügen. Bitte aktivieren Sie diese in Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure necessita dell'autorizzazione accessibilità per incollare automaticamente gli elementi. Abilitala in Impostazioni di Sistema > Privacy e Sicurezza > Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecureはアイテムを自動的に貼り付けるためにアクセシビリティ権限が必要です。システム設定 > プライバシーとセキュリティ > アクセシビリティで有効にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure 需要辅助功能权限来自动粘贴项目。请在系统设置 > 隐私与安全性 > 辅助功能中启用。"
          }
        }
      }
    },
    "ClipySecure will run in the menu bar. Use Cmd+Shift+V to open the clipboard menu at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure läuft in der Menüleiste. Verwenden Sie Cmd+Shift+V, um das Zwischenablage-Menü jederzeit zu öffnen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure funzionerà nella barra dei menu. Usa Cmd+Maiusc+V per aprire il menu degli appunti in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecureはメニューバーで実行されます。Cmd+Shift+Vでいつでもクリップボードメニューを開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipySecure 将在菜单栏中运行。随时使用 Cmd+Shift+V 打开剪贴板菜单。"
          }
        }
      }
    },
