    "A privacy-first clipboard manager for macOS. Your clipboard history is stored locally and encrypted — never sent anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein datenschutzorientierter Zwischenablage-Manager für macOS. Ihr Verlauf wird lokal gespeichert und verschlüsselt — niemals irgendwohin gesendet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gestore degli appunti per macOS incentrato sulla privacy. La cronologia viene archiviata localmente e crittografata — mai inviata da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS用のプライバシー優先のクリップボードマネージャー。履歴はローカルに保存・暗号化され、外部に送信されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私优先的 macOS 剪贴板管理器。您的剪贴板历史存储在本地并加密，绝不会发送到任何地方。"
          }
        }
      }
    },
    "Accessibility Permission" : {
