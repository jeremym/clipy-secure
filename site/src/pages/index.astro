---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import clipboardMenuScreenshot from "../images/screenshots/clip-menu.png";
import privacyPreferencesScreenshot from "../images/screenshots/preferences-privacy.png";

const base = import.meta.env.BASE_URL;
const repositoryUrl = "https://github.com/jeremym/clipy-secure";
const releasesUrl = `${repositoryUrl}/releases/latest`;

const features = [
  ["history", "text, images, files, links, and rich documents"],
  ["paste", "open the menu and press the digit beside a clip"],
  ["search", "full-text index rebuilt in memory at launch"],
  ["memory", "keep selected clips, safe from history cleanup"],
  ["snippets", "reusable text saved in folders"],
  ["obsidian", "send any clip to your vault as a Markdown note"],
  ["exclusions", "ignore selected apps and concealed content"],
];

const privacyDetails = [
  ["database", "AES-GCM encrypted before reaching SQLite"],
  ["key", "stored in the macOS Keychain"],
  ["search index", "memory only; no plaintext index on disk"],
  ["networking", "no telemetry, sync, update check, or networking feature"],
  ["duplicates", "detected with keyed content hashes"],
  ["plaintext exits", "only snippets and Obsidian export, and only by your choice"],
];
---

<BaseLayout
  title="Clipy Secure — Encrypted clipboard history for macOS"
  description="Encrypted clipboard history for macOS with in-memory search and no telemetry, sync, update check, or networking feature."
>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">Clipy Secure</h1>
    <p class="tagline">Encrypted clipboard history for macOS.</p>
    <p class="introduction">
      Clipy Secure keeps copied text, images, files, and links close at hand, and gives every clip a next step: paste
      it, keep it for a while, make it a snippet, or send it to Obsidian. Clipboard history is encrypted locally, search
      stays in memory, and the app has no telemetry, sync, or update check.
    </p>
    <nav class="text-actions" aria-label="Get Clipy Secure">
      <a href={`${base}install/`}>install</a>
      <a href={`${base}how-it-works/`}>how it works</a>
      <a href={repositoryUrl}>source on github <span aria-hidden="true">↗</span></a>
    </nav>
  </section>

  <figure class="screenshot-document screenshot-document--primary">
    <Image
      class="screenshot-image"
      src={clipboardMenuScreenshot}
      alt="Clipy Secure clipboard menu showing recent text clips keyed to digits, numbered folders, snippet folders, a remembered clip, and menu commands"
      loading="lazy"
    />
    <figcaption>figure 01 / clipboard menu / <span aria-hidden="true">⇧⌘V</span></figcaption>
  </figure>

  <div class="workflow">
    <span class="sr-only">Press Shift-Command-V, then press 1. The most recent clip is pasted.</span>
    <span aria-hidden="true"><kbd>⇧⌘V</kbd> <i>→</i> press <kbd>1</kbd> <i>→</i> pasted</span>
  </div>

  <section class="document-section" id="ladder" aria-labelledby="ladder-title">
    <div class="section-heading">
      <h2 id="ladder-title">the memory ladder</h2>
      <hr />
    </div>
    <p class="introduction">
      Not everything you copy matters the same amount. Clipy Secure sorts it into three tiers, and moving a clip up the
      ladder is a single keystroke.
    </p>
    <div class="ladder" role="group" aria-label="History to Memory to Snippets">
      <ol>
        <li>
          <dl class="rung">
            <dt>history</dt>
            <dd>everything you copy, encrypted, expiring on its own (30 days by default).</dd>
          </dl>
        </li>
        <li aria-hidden="true"><span class="arrow">↓ hold ⌥, press m</span></li>
        <li>
          <dl class="rung">
            <dt>memory</dt>
            <dd>clips you choose to keep — a parking lot that never expires (or set an expiry).</dd>
          </dl>
        </li>
        <li aria-hidden="true"><span class="arrow">↓ hold ⌥, press m</span></li>
        <li>
          <dl class="rung">
            <dt>snippets</dt>
            <dd>curated, reusable text in folders, one keystroke from any app.</dd>
          </dl>
        </li>
      </ol>
    </div>
    <p class="introduction">
      Any clip can also leave for your <strong>Obsidian</strong> vault — hold <kbd>⌥</kbd>, press <kbd>o</kbd> — landing
      as a Markdown note.
    </p>
    <p class="section-link"><a href={`${base}how-it-works/`}>how each tier works <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="document-section" id="what-it-does" aria-labelledby="features-title">
    <div class="section-heading">
      <h2 id="features-title">what it does</h2>
      <hr />
    </div>
    <dl class="spec-list">
      {features.map(([label, description]) => (
        <div>
          <dt>{label}</dt>
          <dd>{description}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="document-section" id="privacy" aria-labelledby="privacy-title">
    <div class="section-heading">
      <h2 id="privacy-title">privacy</h2>
      <hr />
    </div>
    <dl class="spec-list">
      {privacyDetails.map(([label, description]) => (
        <div>
          <dt>{label}</dt>
          <dd>{description}</dd>
        </div>
      ))}
    </dl>
    <p class="caveat">
      Clipy Secure has not received an independent security audit, and is signed with the project's own certificate
      rather than an Apple Developer ID — it is not notarized. Local encryption cannot protect the live clipboard on an
      already-compromised, unlocked Mac.
    </p>
    <p class="section-link"><a href={`${base}faq/`}>why not notarized, and more <span aria-hidden="true">→</span></a></p>
  </section>

  <figure class="screenshot-document screenshot-document--secondary">
    <Image
      class="screenshot-image"
      src={privacyPreferencesScreenshot}
      alt="Clipy Secure Privacy preferences showing history expiration, concealed-content handling, duplicate handling, and the clear-history control"
      loading="lazy"
    />
    <figcaption>figure 02 / preferences / privacy</figcaption>
  </figure>

  <section class="document-section build-section" id="install" aria-labelledby="install-title">
    <div class="section-heading">
      <h2 id="install-title">install</h2>
      <hr />
    </div>
    <pre><code>$ brew install --cask jeremym/tap/clipy-secure
$ open -a ClipySecure</code></pre>
    <div class="footnotes">
      <p>requires macOS 14 Sonoma or later. Accessibility permission is requested on first run, for automatic paste.</p>
      <p>Prefer a direct download or building it yourself? See the install page.</p>
    </div>
    <p class="section-link">
      <a href={`${base}install/`}>all install paths <span aria-hidden="true">→</span></a>
      &nbsp;·&nbsp;
      <a href={releasesUrl}>releases <span aria-hidden="true">↗</span></a>
    </p>
  </section>
</BaseLayout>
