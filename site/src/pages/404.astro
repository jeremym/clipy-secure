---
import BaseLayout from "../layouts/BaseLayout.astro";

const home = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found — Clipy Secure"
  description="The page you were looking for could not be found."
  canonical={`${home}404.html`}
  noindex
  structuredData={false}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="error-code">404 / empty history</p>
    <h1 id="not-found-title">Nothing here.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <p><a href={home}>[ return home ]</a></p>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 68vh;
    align-content: center;
    justify-items: start;
    gap: 1rem;
  }

  .error-code {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  h1 {
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.1rem);
  }
</style>
