---
const trustItems = [
  { label: "Encrypted history", detail: "AES-GCM at rest" },
  { label: "In-memory search", detail: "No on-disk index" },
  { label: "No network features", detail: "No telemetry or sync" },
  { label: "Open source", detail: "MIT licensed" },
];
---

<aside class="trust" aria-label="Clipy Secure privacy highlights">
  <ul>
    {trustItems.map((item) => (
      <li>
        <span class="trust__mark" aria-hidden="true"></span>
        <span>
          <strong>{item.label}</strong>
          <small>{item.detail}</small>
        </span>
      </li>
    ))}
  </ul>
</aside>

<style>
  .trust {
    width: min(100% - 2rem, 74rem);
    margin-inline: auto;
    border-block: 1px solid var(--color-border, #2c3935);
    padding-block: 1.25rem;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .trust__mark {
    width: 0.58rem;
    height: 0.58rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-accent, #6ee7c5);
    box-shadow: 0 0 1rem rgba(110, 231, 197, 0.42);
  }

  strong,
  small {
    display: block;
  }

  strong {
    color: var(--color-text, #f5f7f6);
    font-size: 0.9rem;
    line-height: 1.3;
  }

  small {
    margin-top: 0.12rem;
    color: var(--color-text-subtle, #82908c);
    font-size: 0.74rem;
    line-height: 1.3;
  }

  @media (max-width: 720px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (max-width: 380px) {
    .trust {
      width: min(100% - 1.25rem, 74rem);
    }

    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
