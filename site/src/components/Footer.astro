---
interface Props {
  githubUrl?: string;
  upstreamUrl?: string;
}

const {
  githubUrl = "https://github.com/jeremym/clipy-secure",
  upstreamUrl = "https://github.com/Clipy/Clipy",
} = Astro.props;
---

<footer class="site-footer">
  <span><a href={`${githubUrl}/blob/main/LICENSE`}>MIT licensed</a></span>
  <span>independent rewrite inspired by <a href={upstreamUrl}>Clipy <span aria-hidden="true">↗</span></a></span>
  <span><a href={githubUrl}>github <span aria-hidden="true">↗</span></a></span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin-top: clamp(5rem, 13vw, 8rem);
    border-top: 1px solid var(--color-rule);
    padding-block: 0.9rem 2.5rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-footnote);
    line-height: 1.55;
  }
</style>
