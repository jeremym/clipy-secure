---
interface Props {
  githubUrl?: string;
}

const {
  githubUrl = "https://github.com/jeremym/clipy-secure",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.replace(/\/+$/, "");

const links = [
  ["how it works", `${base}how-it-works/`],
  ["compare", `${base}compare/`],
  ["install", `${base}install/`],
  ["faq", `${base}faq/`],
];

function isCurrent(href: string): boolean {
  return current === href.replace(/\/+$/, "");
}
---

<header class="site-header">
  <div class="header-row">
    <a class="wordmark" href={base} aria-label="Clipy Secure home">clipy secure</a>
    <a href={githubUrl}>github <span aria-hidden="true">↗</span></a>
  </div>
  <nav class="site-nav" aria-label="Primary">
    {links.map(([label, href]) => (
      <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    padding-top: clamp(1.5rem, 4vw, 2.75rem);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .wordmark {
    color: var(--color-text);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-accent);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.3rem;
    padding-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .site-nav a[aria-current="page"] {
    color: var(--color-accent);
    text-decoration-thickness: 2px;
  }
</style>
