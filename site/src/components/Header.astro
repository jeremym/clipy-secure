---
interface Props {
  githubUrl?: string;
}

const {
  githubUrl = "https://github.com/jeremym/clipy-secure",
} = Astro.props;
const home = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={home} aria-label="Clipy Secure home">
      <svg class="wordmark-mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 3.25 26 7v7.7c0 6.35-3.78 11.42-10 14.05-6.22-2.63-10-7.7-10-14.05V7l10-3.75Z" />
        <path d="M12.2 15.85v-3a3.8 3.8 0 0 1 7.6 0v6a5.3 5.3 0 0 1-10.6 0v-6.5" />
      </svg>
      <span>Clipy Secure</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        <li><a href={`${home}#features`}>Features</a></li>
        <li><a href={`${home}#privacy`}>Privacy</a></li>
        <li><a href={`${home}#install`}>Install</a></li>
        <li><a class="nav-github" href={githubUrl}>GitHub<span class="external-marker" aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 72%, transparent);
    background: color-mix(in srgb, var(--color-bg) 84%, transparent);
    backdrop-filter: blur(18px) saturate(135%);
  }

  .header-inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .wordmark {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 680;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .wordmark-mark {
    width: 1.7rem;
    height: 1.7rem;
    overflow: visible;
    fill: color-mix(in srgb, var(--color-accent) 14%, transparent);
    stroke: var(--color-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .wordmark-mark path:last-child {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.55;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2.4vw, 1.7rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    font-weight: 560;
    text-decoration: none;
  }

  .nav-list a:hover {
    color: var(--color-text);
  }

  .nav-github {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28rem;
  }

  .external-marker {
    color: var(--color-accent);
    font-size: 0.8em;
  }

  @media (max-width: 42rem) {
    .site-header {
      position: relative;
    }

    .header-inner {
      min-height: 4rem;
    }

    .nav-list li:not(:last-child) {
      display: none;
    }
  }
</style>
