---
const repositoryUrl = "https://github.com/jeremym/clipy-secure";
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__copy">
    <p class="eyebrow">Private by design. Fast by habit.</p>
    <h1 id="hero-heading">Your clipboard remembers everything. Only you should be able to read it.</h1>
    <p class="hero__lede">
      Clipy Secure is a privacy-first clipboard manager for macOS with encrypted history,
      in-memory search, fast keyboard-driven pasting, and no network features.
    </p>
    <div class="hero__actions" role="group" aria-label="Get Clipy Secure">
      <a class="button button--primary" href="#install">Build from source</a>
      <a class="button button--secondary" href={repositoryUrl}>View on GitHub</a>
    </div>
    <p class="hero__requirement">Requires macOS 14 Sonoma or later.</p>
  </div>

  <figure class="hero-shot">
    <div class="shot-placeholder" role="img" aria-label="Placeholder for a screenshot of the Clipy Secure clipboard menu">
      <div class="shot-placeholder__halo" aria-hidden="true"></div>
      <div class="mock-menu" aria-hidden="true">
        <div class="mock-menu__header">
          <span class="mock-menu__title">Clipy Secure</span>
          <span class="mock-menu__shortcut">⇧⌘V</span>
        </div>
        <div class="mock-menu__row mock-menu__row--selected">
          <span>Project notes for Friday</span><kbd>A</kbd>
        </div>
        <div class="mock-menu__row">
          <span>hello@example.com</span><kbd>B</kbd>
        </div>
        <div class="mock-menu__row">
          <span>Design review at 2:00</span><kbd>C</kbd>
        </div>
        <div class="mock-menu__divider"></div>
        <div class="mock-menu__row mock-menu__row--muted">
          <span>Search history…</span><span>⌃⌘V</span>
        </div>
      </div>
      <span class="shot-placeholder__label">Clipboard menu · 1600 × 1000 px</span>
    </div>
    <figcaption>Clipboard history is always one shortcut away.</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(22rem, 1.08fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
    width: min(100% - 2rem, 74rem);
    margin-inline: auto;
    padding-block: clamp(5rem, 11vw, 9rem) clamp(3.5rem, 8vw, 7rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent, #6ee7c5);
    font-size: 0.78rem;
    font-weight: 720;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--color-text, #f5f7f6);
    font-size: clamp(2.65rem, 5.8vw, 5.1rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero__lede {
    max-width: 38rem;
    margin: 1.6rem 0 0;
    color: var(--color-text-muted, #b5c0bd);
    font-size: clamp(1.04rem, 1.4vw, 1.22rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.78rem 1.25rem;
    font-weight: 680;
    line-height: 1;
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-accent, #6ee7c5) 65%, transparent);
    outline-offset: 3px;
  }

  .button--primary {
    background: var(--color-accent, #6ee7c5);
    color: #071411;
  }

  .button--primary:hover {
    background: #8aefd3;
  }

  .button--secondary {
    border-color: var(--color-border, #33413d);
    background: color-mix(in srgb, var(--color-surface, #15201d) 86%, transparent);
    color: var(--color-text, #f5f7f6);
  }

  .button--secondary:hover {
    border-color: #6a7b76;
  }

  .hero__requirement {
    margin: 1rem 0 0;
    color: var(--color-text-subtle, #82908c);
    font-size: 0.84rem;
  }

  .hero-shot {
    min-width: 0;
    margin: 0;
  }

  .shot-placeholder {
    position: relative;
    display: grid;
    aspect-ratio: 8 / 5;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent, #6ee7c5) 20%, var(--color-border, #33413d));
    border-radius: clamp(1.2rem, 3vw, 2rem);
    background:
      radial-gradient(circle at 75% 20%, rgba(115, 225, 190, 0.16), transparent 40%),
      radial-gradient(circle at 12% 85%, rgba(64, 179, 210, 0.18), transparent 42%),
      #0c1211;
    box-shadow: 0 2.5rem 7rem rgba(0, 0, 0, 0.38);
    isolation: isolate;
  }

  .shot-placeholder::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 32px 32px;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 80%);
  }

  .shot-placeholder__halo {
    position: absolute;
    width: 65%;
    height: 65%;
    border-radius: 50%;
    background: rgba(92, 223, 183, 0.14);
    filter: blur(50px);
  }

  .mock-menu {
    position: relative;
    width: min(72%, 23rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.9rem;
    background: rgba(30, 34, 33, 0.94);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.5);
    color: #eef2f0;
    font-size: clamp(0.62rem, 1.2vw, 0.82rem);
    backdrop-filter: blur(22px);
  }

  .mock-menu__header,
  .mock-menu__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mock-menu__header {
    padding: 0.75rem 0.85rem 0.55rem;
    color: #8f9b97;
    font-size: 0.78em;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mock-menu__row {
    margin: 0 0.35rem;
    border-radius: 0.42rem;
    padding: 0.54rem 0.62rem;
  }

  .mock-menu__row--selected {
    background: linear-gradient(90deg, #178f80, #169581);
  }

  .mock-menu__row--muted {
    color: #9eaaa6;
  }

  .mock-menu__divider {
    height: 1px;
    margin: 0.35rem 0.7rem;
    background: rgba(255, 255, 255, 0.1);
  }

  kbd {
    min-width: 1.3rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.3rem;
    padding: 0.08rem 0.24rem;
    background: rgba(255, 255, 255, 0.07);
    color: inherit;
    font: inherit;
    text-align: center;
  }

  .shot-placeholder__label {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    color: rgba(230, 238, 235, 0.55);
    font-size: clamp(0.58rem, 1vw, 0.72rem);
    letter-spacing: 0.03em;
  }

  figcaption {
    margin-top: 0.8rem;
    color: var(--color-text-subtle, #82908c);
    font-size: 0.82rem;
    text-align: center;
  }

  @media (max-width: 850px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 3.25rem;
      padding-top: 4.5rem;
    }

    h1 {
      max-width: 15ch;
    }

    .hero__copy {
      max-width: 42rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      width: min(100% - 1.25rem, 74rem);
    }

    .hero__actions,
    .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

    .button:hover {
      transform: none;
    }
  }
</style>
