---
const features = [
  {
    number: "01",
    title: "Clipboard history",
    description: "Keep text, images, files, links, and rich content close at hand.",
  },
  {
    number: "02",
    title: "One-key paste",
    description: "Open the menu and press a letter or number to paste—no extra step required.",
  },
  {
    number: "03",
    title: "Live search",
    description: "Find past clips instantly with a full-text index rebuilt in memory at launch.",
  },
  {
    number: "04",
    title: "Snippets and memory",
    description: "Save reusable text or pin important clips so they never expire.",
  },
  {
    number: "05",
    title: "Thoughtful exclusions",
    description: "Skip selected apps and respect concealed content from compatible password managers.",
  },
];
---

<section class="features" id="features" aria-labelledby="features-heading">
  <div class="features__intro">
    <p class="eyebrow">Made for momentum</p>
    <h2 id="features-heading">The useful parts of clipboard history, kept simple.</h2>
  </div>

  <div class="features__grid">
    {features.map((feature) => (
      <article class="feature">
        <span class="feature__number" aria-hidden="true">{feature.number}</span>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .features {
    width: min(100% - 2rem, 74rem);
    margin-inline: auto;
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .features__intro {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .eyebrow {
    margin: 0.25rem 0 0;
    color: var(--color-accent, #6ee7c5);
    font-size: 0.76rem;
    font-weight: 720;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-text, #f5f7f6);
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature {
    grid-column: span 2;
    min-height: 13.5rem;
    border: 1px solid var(--color-border, #2c3935);
    border-radius: var(--radius-card, 1.25rem);
    padding: clamp(1.25rem, 3vw, 1.8rem);
    background: color-mix(in srgb, var(--color-surface, #15201d) 70%, transparent);
  }

  .feature:nth-child(4),
  .feature:nth-child(5) {
    grid-column: span 3;
  }

  .feature__number {
    display: inline-block;
    color: var(--color-accent, #6ee7c5);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 2.8rem 0 0.65rem;
    color: var(--color-text, #f5f7f6);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .feature p {
    max-width: 34ch;
    margin: 0;
    color: var(--color-text-muted, #b5c0bd);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 740px) {
    .features__intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature,
    .feature:nth-child(4),
    .feature:nth-child(5) {
      grid-column: span 1;
    }

    .feature:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 500px) {
    .features {
      width: min(100% - 1.25rem, 74rem);
    }

    .features__grid {
      grid-template-columns: 1fr;
    }

    .feature:last-child {
      grid-column: auto;
    }

    .feature {
      min-height: 0;
    }

    h3 {
      margin-top: 2rem;
    }
  }
</style>
